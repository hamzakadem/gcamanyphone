<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="@color/shutter_outer" />
            <size
                android:width="76dp"
                android:height="76dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/shutter_inner_pressed" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/shutter_inner" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>
