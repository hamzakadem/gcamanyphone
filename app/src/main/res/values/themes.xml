<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.GCamCompatibleCamera" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/camera_accent</item>
        <item name="colorPrimaryVariant">@color/camera_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <!-- Fullscreen Camera Theme -->
    <style name="Theme.GCamCompatibleCamera.Fullscreen" parent="Theme.GCamCompatibleCamera">
        <item name="android:windowBackground">@color/camera_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
